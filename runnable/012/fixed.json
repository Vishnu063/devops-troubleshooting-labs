{
  "services": {
    "web": {
      "image": "nginx:1.28-alpine",
      "ports": [
        "127.0.0.1::80"
      ],
      "volumes": [
        "./assets/nginx.conf:/etc/nginx/nginx.conf:ro"
      ],
      "depends_on": [
        "backend"
      ],
      "command": [
        "sh",
        "-c",
        "sed s/backend:9000/backend:80/ /etc/nginx/nginx.conf > /tmp/fixed.conf; exec nginx -c /tmp/fixed.conf -g \"daemon off;\""
      ]
    },
    "backend": {
      "image": "nginx:1.28-alpine"
    }
  }
}
